       <item><property name="text"><string>Every 5 minutes</string></property></item>
       <item><property name="text"><string>Every 10 minutes</string></property></item>
       <item><property name="text"><string>Every 30 minutes</string></property></item>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="recoveryOffHintLabel">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Off stops new recovery writes. Save with Ctrl+S to keep work.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="recoveryDialogButtons">
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
