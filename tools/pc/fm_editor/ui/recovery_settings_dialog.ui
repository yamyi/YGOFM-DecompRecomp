<ui version="4.0">
 <class>RecoverySettingsDialog</class>
 <widget class="QDialog" name="RecoverySettingsDialog">
  <property name="windowTitle"><string>Recovery copy</string></property>
  <property name="minimumSize"><size><width>450</width><height>150</height></size></property>
  <layout class="QVBoxLayout" name="recoveryDialogLayout">
   <item>
    <widget class="QLabel" name="recoveryExplanationLabel">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Recovery copies protect unsaved work if the editor closes unexpectedly. They are written only after real edits, at the selected interval.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="recoveryFormLayout">
     <item row="0" column="0"><widget class="QLabel" name="recoveryIntervalLabel"><property name="text"><string>Write recovery copy</string></property></widget></item>
