                          <item>
                            <widget class="QLabel" name="storySyntaxHint">
                              <property name="text"><string>A line a page. Before one, its stage in brackets: [scene: torch corridor] [left: 1] [right: opponent] [pan: 64 0 30 wait]. @left:/@right: that side, @Name: a duelist, @none: nobody's; #N: campaign portrait 0-24, #speaker: the speaker's own face. \n breaks a line inside the box; a backslash keeps the next letter as it is.</string></property>
                              <property name="wordWrap"><bool>true</bool></property>
                            </widget>
