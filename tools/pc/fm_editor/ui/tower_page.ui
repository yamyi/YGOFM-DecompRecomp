                      <widget class="QGroupBox" name="towerOnlyGroup">
                        <property name="title"><string>The tower's own duelists</string></property>
                        <layout class="QVBoxLayout" name="towerOnlyGroupLayout">
                          <property name="leftMargin"><number>12</number></property>
                          <property name="topMargin"><number>12</number></property>
                          <property name="rightMargin"><number>12</number></property>
                          <property name="bottomMargin"><number>12</number></property>
                          <property name="spacing"><number>7</number></property>
                          <item>
                            <widget class="QLabel" name="towerOnlyHint">
                              <property name="text"><string>Checked: not in Free Duel until a won floor fights it or names it in its reward ("tower_only"). The mod's added duelists, from the Duelists page.</string></property>
                              <property name="wordWrap"><bool>true</bool></property>
                            </widget>
                          </item>
                          <item><widget class="QListWidget" name="towerOnlyDuelistsList"/></item>
                        </layout>
                      </widget>
                    </item>
                  </layout>
                </widget>
              </item>
              <item>
                <widget class="QWidget" name="towerRightColumn">
                  <property name="minimumWidth"><number>575</number></property>
                  <layout class="QVBoxLayout" name="towerRightLayout">
                    <property name="leftMargin"><number>0</number></property>
                    <property name="topMargin"><number>0</number></property>
                    <property name="rightMargin"><number>0</number></property>
                    <property name="bottomMargin"><number>0</number></property>
                    <property name="spacing"><number>10</number></property>
                    <item>
                      <widget class="QGroupBox" name="floorsGroup">
                        <property name="title"><string>Floors</string></property>
                        <layout class="QVBoxLayout" name="floorsGroupLayout">
                          <property name="leftMargin"><number>12</number></property>
                          <property name="topMargin"><number>12</number></property>
                          <property name="rightMargin"><number>12</number></property>
                          <property name="bottomMargin"><number>12</number></property>
                          <property name="spacing"><number>7</number></property>
                          <item>
                            <widget class="QTreeWidget" name="floorsTree">
                              <property name="minimumHeight"><number>180</number></property>
                              <property name="rootIsDecorated"><bool>false</bool></property>
                              <column><property name="text"><string>#</string></property></column>
                              <column><property name="text"><string>Opponent</string></property></column>
                              <column><property name="text"><string>Field</string></property></column>
                              <column><property name="text"><string>Rules</string></property></column>
                            </widget>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="floorActionsRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QPushButton" name="addFloorButton"><property name="text"><string>Add floor</string></property></widget></item>
                              <item><widget class="QPushButton" name="removeFloorButton"><property name="text"><string>Remove</string></property></widget></item>
                              <item><widget class="QPushButton" name="moveFloorUpButton"><property name="text"><string>Up</string></property></widget></item>
                              <item><widget class="QPushButton" name="moveFloorDownButton"><property name="text"><string>Down</string></property></widget></item>
                            </layout>
                          </item>
                        </layout>
                      </widget>
                    </item>
                    <item>
                      <widget class="QGroupBox" name="floorSettingsGroup">
                        <property name="title"><string>The floor</string></property>
                        <layout class="QVBoxLayout" name="floorSettingsGroupLayout">
                          <property name="leftMargin"><number>12</number></property>
                          <property name="topMargin"><number>12</number></property>
                          <property name="rightMargin"><number>12</number></property>
                          <property name="bottomMargin"><number>12</number></property>
                          <property name="spacing"><number>7</number></property>
                          <item>
                            <layout class="QHBoxLayout" name="floorOpponentRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="floorOpponentLabel"><property name="text"><string>Opponent</string></property></widget></item>
                              <item><widget class="QComboBox" name="floorOpponentCombo"><property name="editable"><bool>true</bool></property></widget></item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="floorFieldRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="floorFieldLabel"><property name="text"><string>Field</string></property></widget></item>
                              <item>
                                <widget class="QComboBox" name="floorFieldCombo">
                                  <item><property name="text"><string>none</string></property></item>
                                  <item><property name="text"><string>Forest</string></property></item>
                                  <item><property name="text"><string>Wasteland</string></property></item>
                                  <item><property name="text"><string>Mountain</string></property></item>
                                  <item><property name="text"><string>Meadow</string></property></item>
                                  <item><property name="text"><string>Sea</string></property></item>
                                  <item><property name="text"><string>Dark</string></property></item>
                                </widget>
                              </item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="floorLpRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="playerLpLabel"><property name="text"><string>Your LP</string></property></widget></item>
                              <item><widget class="QLineEdit" name="playerLpEdit"><property name="placeholderText"><string>usual</string></property></widget></item>
                              <item><widget class="QLabel" name="opponentLpLabel"><property name="text"><string>Its LP</string></property></widget></item>
                              <item><widget class="QLineEdit" name="opponentLpEdit"><property name="placeholderText"><string>usual</string></property></widget></item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="floorFlagsRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QCheckBox" name="noFusionsCheck"><property name="text"><string>No fusions</string></property></widget></item>
                              <item><widget class="QCheckBox" name="noEquipsCheck"><property name="text"><string>No equips</string></property></widget></item>
                              <item><widget class="QCheckBox" name="checkpointCheck"><property name="text"><string>Checkpoint (a loss after it comes back here)</string></property></widget></item>
                            </layout>
                          </item>
                          <item>
                            <widget class="QCheckBox" name="unlockOpponentCheck">
                              <property name="text"><string>Unlock this opponent in Free Duel when beaten</string></property>
                              <property name="toolTip"><string>Beaten for the first time, the floor's opponent appears on the Free Duel grid. A duelist the mod adds as the tower's own (tower_only) is hidden there until then; unticked, it stays hidden.</string></property>
                            </widget>
                          </item>
                          <item><widget class="QLabel" name="unlockOpponentHint"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
                          <item>
                            <layout class="QHBoxLayout" name="rewardCardsRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="rewardCardsLabel"><property name="text"><string>Reward cards (names/IDs, a comma between)</string></property></widget></item>
                              <item><widget class="QLineEdit" name="rewardCardsEdit"/></item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="rewardStarchipsRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="rewardStarchipsLabel"><property name="text"><string>Starchips (first win only)</string></property></widget></item>
                              <item><widget class="QLineEdit" name="rewardStarchipsEdit"/></item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="unlockRewardRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QLabel" name="rewardUnlocksLabel"><property name="text"><string>Also unlocks</string></property></widget></item>
                              <item><widget class="QLineEdit" name="rewardUnlocksEdit"><property name="readOnly"><bool>true</bool></property></widget></item>
                            </layout>
                          </item>
                          <item>
                            <layout class="QHBoxLayout" name="unlockRewardPickerRowLayout">
                              <property name="spacing"><number>7</number></property>
                              <item><widget class="QComboBox" name="rewardUnlockDuelistCombo"/></item>
                              <item><widget class="QPushButton" name="addRewardUnlockButton"><property name="text"><string>Add</string></property></widget></item>
                              <item><widget class="QPushButton" name="removeRewardUnlockButton"><property name="text"><string>Remove last</string></property></widget></item>
                            </layout>
                          </item>
                          <item><widget class="QLabel" name="floorDeckLabel"><property name="text"><string>Its deck (one card per line, e.g. Card x3; 40 total; empty = own deck)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
                          <item>
                            <widget class="QPlainTextEdit" name="floorDeckEdit">
                              <property name="minimumHeight"><number>105</number></property>
                              <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
                            </widget>
                          </item>
                          <item><widget class="QLabel" name="floorBeforeLabel"><property name="text"><string>Before the duel</string></property></widget></item>
                          <item>
                            <widget class="QPlainTextEdit" name="beforeDuelStoryEdit">
                              <property name="minimumHeight"><number>92</number></property>
                              <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
                            </widget>
                          </item>
                          <item><widget class="QLabel" name="floorAfterLabel"><property name="text"><string>After a win</string></property></widget></item>
                          <item>
                            <widget class="QPlainTextEdit" name="afterWinStoryEdit">
                              <property name="minimumHeight"><number>92</number></property>
                              <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
                            </widget>
                          </item>
                        </layout>
                      </widget>
                    </item>
                  </layout>
                </widget>
              </item>
            </layout>
          </widget>
        </widget>
      </item>
    </layout>
  </widget>
</ui>
