<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0"><class>DuelistBustDialog</class><widget class="QDialog" name="DuelistBustDialog"><property name="windowTitle"><string>Bust editor</string></property><property name="minimumSize"><size><width>800</width><height>560</height></size></property><layout class="QVBoxLayout" name="bustOuter"><item><widget class="QLabel" name="bustDescription"><property name="text"><string>Dialogue bust expressions. The default expression is numbered first by the game.</string></property></widget></item><item><layout class="QHBoxLayout" name="bustBody"><item><widget class="QListWidget" name="bustExpressionList"><property name="minimumSize"><size><width>190</width><height>0</height></size></property></widget></item><item><layout class="QVBoxLayout" name="bustPreviewColumn"><item><widget class="QLabel" name="bustPreview"><property name="minimumSize"><size><width>320</width><height>240</height></size></property><property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property></widget></item><item><widget class="QComboBox" name="bustFrameMode"><item><property name="text"><string>Picture</string></property><property name="userData"><string>image</string></property></item><item><property name="text"><string>Talk 1</string></property><property name="userData"><string>talk0</string></property></item><item><property name="text"><string>Talk 2</string></property><property name="userData"><string>talk1</string></property></item><item><property name="text"><string>Blink</string></property><property name="userData"><string>blink</string></property></item></widget></item><item><widget class="QComboBox" name="bustSide"><item><property name="text"><string>Left</string></property><property name="userData"><string>left</string></property></item><item><property name="text"><string>Right</string></property><property name="userData"><string>right</string></property></item></widget></item></layout></item><item><layout class="QVBoxLayout" name="bustActions"><item><widget class="QPushButton" name="bustAddButton"><property name="text"><string>Add expression…</string></property></widget></item><item><widget class="QPushButton" name="bustRenameButton"><property name="text"><string>Rename…</string></property></widget></item><item><widget class="QPushButton" name="bustRemoveButton"><property name="text"><string>Remove expression</string></property></widget></item><item><widget class="QPushButton" name="bustDefaultButton"><property name="text"><string>Make default</string></property></widget></item><item><widget class="QPushButton" name="bustUpButton"><property name="text"><string>Move up</string></property></widget></item><item><widget class="QPushButton" name="bustDownButton"><property name="text"><string>Move down</string></property></widget></item><item><widget class="QPushButton" name="bustPictureButton"><property name="text"><string>Replace picture…</string></property></widget></item><item><widget class="QPushButton" name="bustTalkButton"><property name="text"><string>Add talking frame…</string></property></widget></item><item><widget class="QPushButton" name="bustUntalkButton"><property name="text"><string>Clear talking frames</string></property></widget></item><item><widget class="QPushButton" name="bustBlinkButton"><property name="text"><string>Replace blink…</string></property></widget></item><item><widget class="QPushButton" name="bustUnblinkButton"><property name="text"><string>Clear blink</string></property></widget></item><item><widget class="QPushButton" name="bustDropButton"><property name="text"><string>Remove bust</string></property></widget></item><item><widget class="QCheckBox" name="bustReplaceCheck"><property name="text"><string>Use for campaign character too</string></property></widget></item><item><spacer name="bustActionsSpacer"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item><item><widget class="QLabel" name="bustNote"><property name="wordWrap"><bool>true</bool></property></widget></item></layout></item></layout></item><item><widget class="QPushButton" name="bustCloseButton"><property name="text"><string>Close</string></property></widget></item></layout></widget><resources/><connections/></ui>
