     <widget class="QWidget" name="FramesPage">
      <property name="windowTitle">
       <string>Card frames — FM Editor</string>
      </property>
      <property name="styleSheet">
       <string>QWidget#FramesPage { background:#071525; color:#dce9fa; font-family: &quot;DejaVu Sans&quot;, &quot;Segoe UI&quot;; font-size:12px; }
QFrame { background:#091f36; border:1px solid #1a456e; border-radius:7px; }
QFrame#cardCanvas { background:#071222; border:1px solid #173857; }
QFrame#cardSurface { background:#374563; border:2px solid #7c94b4; border-radius:0px; }
QFrame#artPlace { background:#254d70; border:1px dashed #7ca3c9; border-radius:0px; }
QFrame#cardTop,#cardStat { background:#3b506d; border:none; border-radius:0px; }
QLabel { background:transparent; border:none; color:#dce9fa; }
QLabel#titleHeading {font-size:18px;font-weight:bold;color:white;}
QLabel#cardName {font-family:serif;font-size:20px;color:white;}
QLabel#cardStats {font-weight:bold;font-size:19px;color:white;}
QLabel#helpText {color:#9fb3c9;font-size:11px;}
QPushButton {background:#102f50;border:1px solid #27547d;border-radius:5px;padding:4px 8px;color:#e6f0fe;}
QPushButton:hover {background:#17568f;} QPushButton:pressed {background:#176cc8;}
QLineEdit,QComboBox,QSpinBox,QListWidget,QTreeWidget {background:#06192b;border:1px solid #2b587d;border-radius:4px;color:#e3edf9;padding:2px;selection-background-color:#1164d0;}
QTreeWidget::item {height:20px;} QCheckBox,QRadioButton {color:#dce9fa;background:transparent;} QGroupBox {color:#a9c8ee;border:1px solid #214868;border-radius:7px;margin-top:12px;padding-top:10px;font-weight:bold;} QGroupBox::title {subcontrol-origin:margin;left:10px;}</string>
      </property>
      <attribute name="title">
       <string>Frames</string>
      </attribute>
      <layout class="QVBoxLayout" name="framesPageLayout">
       <property name="spacing">
        <number>10</number>
       </property>
       <property name="leftMargin">
        <number>12</number>
       </property>
       <property name="topMargin">
        <number>8</number>
       </property>
       <property name="rightMargin">
        <number>12</number>
       </property>
       <property name="bottomMargin">
        <number>12</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="framesHeaderLayout">
         <property name="spacing">
          <number>6</number>
         </property>
         <item>
          <widget class="QLabel" name="titleHeading">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text">
            <string>Card frames</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="subtitle">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text">
            <string>Edit card-viewer and duel-hand frame styles. Choose an element; drag, resize or hide it.</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="showRetailButton">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text">
            <string>Hold: the game's</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="revertRetailButton">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text">
            <string>Revert to retail...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QSplitter" name="framesContentSplitter">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
           <horstretch>0</horstretch>
           <verstretch>1</verstretch>
          </sizepolicy>
         </property>
         <property name="orientation">
